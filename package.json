{
  "name": "hackeruna-frontend",
  "version": "2.2.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "clean": "rm -rf dist .angular",
    "build": "npm run clean && ng build && node copy-htaccess.js",
    "build:prod": "npm run clean && ng build --configuration production && node copy-htaccess.js",
    "watch": "ng build --watch --configuration development",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.1.2",
    "@angular/compiler": "^22.1.2",
    "@angular/core": "^22.1.2",
    "@angular/forms": "^22.1.2",
    "@angular/platform-browser": "^22.1.2",
    "@angular/platform-browser-dynamic": "^22.1.2",
    "@angular/router": "^22.1.2",
    "@jsverse/transloco": "^8.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.0",
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.2",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.19",
    "@types/jasmine": "~5.1.0",
    "@vitest/ui": "^4.0.8",
    "autoprefixer": "^10.4.21",
    "happy-dom": "^20.0.10",
    "jasmine-core": "~5.6.0",
    "jsdom": "^27.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "~6.0.3",
    "vitest": "^4.0.8"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.9": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true,
    "fsevents@2.3.3": true,
    "@parcel/watcher@2.6.0": true
  }
}
